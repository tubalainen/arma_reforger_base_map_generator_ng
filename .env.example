# OpenTopography API key (REQUIRED for global DEM fallback)
# Register for FREE at: https://portal.opentopography.org/
# After registering, go to "My Account" to get your API key
# Used for: Copernicus DEM 30m (COP30), SRTM 30m, ALOS World 3D 30m
# Replace demoapikey with your personal key to get higher details, register above
OPENTOPOGRAPHY_API_KEY=demoapikey

# Sweden - Lantmäteriet STAC API (elevation, vector, orthophotos)
# Register at https://apimanager.lantmateriet.se/
# Provides: 1-2m elevation (LiDAR), sub-meter orthophotos, official vector data
LANTMATERIET_USERNAME=
LANTMATERIET_PASSWORD=

# Denmark - Dataforsyningen
# Register at https://dataforsyningen.dk/
DATAFORSYNINGEN_TOKEN=

# Finland - NLS / Maanmittauslaitos
# Register at https://www.maanmittauslaitos.fi/en/rajapinnat/api-avaimen-ohje
NLS_FINLAND_API_KEY=

# Norway and Estonia require no API keys (open WCS endpoints)
# Latvia and Lithuania use Copernicus DEM 30m fallback via OpenTopography

# ==============================================================================
# Security Configuration (for reverse proxy setup)
# ==============================================================================

# CORS allowed origins (comma-separated)
# Add your domain when using nginx/Cloudflare reverse proxy
# Example: CORS_ORIGINS=https://maps.yourdomain.com,http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting
# General requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Map generation requests per hour per IP
RATE_LIMIT_GENERATE_PER_HOUR=10

# Trusted proxy IPs for forwarded headers (comma-separated)
# Used when behind nginx/Cloudflare
FORWARDED_ALLOW_IPS=127.0.0.1

# Log verbosity. Controls BOTH `docker compose logs` and the browser
# Activity Log — they are fed from the same records, so they can't drift apart.
# DEBUG adds per-tile / per-feature tracing: useful when diagnosing one
# specific map, very noisy otherwise.
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Container timezone — controls timestamps in server logs.
# Defaults to UTC if unset. Set to your local timezone so server logs
# match the browser UI timestamps.
# Examples: Europe/Stockholm, Europe/Berlin, America/New_York
TZ=UTC

# ---------------------------------------------------------------------------
# OpenStreetMap / Overpass
# ---------------------------------------------------------------------------
# The app queries a pool of public Overpass mirrors, probing them before each
# generation and using the fastest healthy one. Nothing here needs setting for
# normal use.

# Exclude the VK Maps mirror (maps.mail.ru) from the pool. It is a working,
# unmetered planet mirror, but it is Russian-operated — set this to 1 if that
# is not acceptable in your deployment.
# OVERPASS_DISABLE_VK=0

# Cache successful Overpass responses on disk, so regenerating the same square
# is instant and puts no load on the volunteer-run mirrors.
# OVERPASS_CACHE_ENABLED=1
# OVERPASS_CACHE_TTL_HOURS=24
# OVERPASS_CACHE_MAX_MB=512

# --- Optional: self-hosted Overpass sidecar (docker compose profile local-osm)
#
# Runs a local Overpass instance holding one country extract, so OSM queries
# never touch a public mirror. Entirely optional — leave OVERPASS_LOCAL_COUNTRIES
# unset and the app behaves exactly as it does without it.
#
# Start it with:  docker compose --profile local-osm up -d
#
# Pick the extract by ISO country code. One sidecar holds ONE extract, so list
# exactly one country; the app only uses it for bboxes inside that country and
# falls back to the public pool everywhere else.
# Available: SE NO DK FI EE LV LT DE PL RU GB FR ES IT AT CH CZ NL BE UA RO HU
#            SK HR RS BG GR PT IE IS
# OVERPASS_LOCAL_COUNTRIES=SE
#
# The first boot downloads the extract and builds the database — hours for a
# large country, and roughly 10x the compressed size on disk (Sweden's 0.76 GB
# extract lands near 8 GB). The web app keeps using public mirrors until it is
# ready, and the web UI shows the progress. The mirror publishes a diff stream
# which the sidecar applies by itself; no cron needed.
#
# The extract is downloaded once, by the init step, onto a volume of its own
# (overpass_extract). The Overpass container is handed a local file and never
# talks to a download mirror, so no restart of it can cost bandwidth — and
# `docker volume rm ..._overpass_db`, the way to retry a failed import, does
# not throw the download away. Budget the compressed size once more on top of
# the figure above.
#
# If the download itself keeps failing, the init step stops: 3 failed attempts
# in 6 hours, or 3x the extract size pulled in 24 hours, and it refuses to try
# again and exits. The sidecar then never starts. That ledger lives on the
# extract volume, so it survives `docker compose up --force-recreate`; clear it
# deliberately with `docker volume rm ..._overpass_extract` once whatever was
# failing is actually fixed.
#
# Changing the country above and restarting the sidecar automatically wipes the
# old database and re-imports. Until you restart, the web UI flags that the
# running container no longer matches this file.
#
# For more than one country, set an explicit region instead (much larger):
# OVERPASS_LOCAL_REGION=europe
#
# Where the extract is downloaded from. Two mirrors are known:
#
#   geofabrik  (default)  all countries listed above, daily diffs
#   osmfr                 download.openstreetmap.fr, minutely diffs, covers
#                         SE NO DK FI DE PL RU GB FR ES IT AT CH CZ NL BE UA
#                         SK PT IE — but NOT EE LV LT RO HU HR RS BG GR IS
#
# Switch mirrors if Geofabrik stops answering. They firewall IP addresses that
# re-download large extracts repeatedly, and the symptom is a connection that
# times out rather than an HTTP error — from a browser too, not just Docker.
# The region marker is mirror-independent, so switching does NOT re-import.
# OVERPASS_LOCAL_MIRROR=geofabrik
#
# Full escape hatch: point the sidecar anywhere, including a hand-downloaded
# extract on the volume. Both are passed to the container untouched, and each
# overrides whatever OVERPASS_LOCAL_MIRROR would have produced. The diff
# directory must use the standard osmosis layout (state.txt plus
# NNN/NNN/NNN.osc.gz); leave it empty to import once and never update.
# OVERPASS_PLANET_URL=file:///db/extract_cache/planet-europe_sweden.osm.pbf
# OVERPASS_DIFF_URL=https://download.openstreetmap.fr/replication/europe/sweden/minute/
#
# Seconds between diff sweeps. Defaults to a week: OSM road and coastline
# geometry does not move fast enough for a terrain generator to notice, and the
# mirrors are volunteer-run. Lower it for fresher data; anything under an hour
# is clamped to an hour.
# OVERPASS_UPDATE_SLEEP=604800
#
# Refuse public mirrors entirely — private or air-gapped deployments only.
# Generations fail rather than fall back if the sidecar is unavailable.
# OVERPASS_LOCAL_ONLY=0
#
# Flag the sidecar as stale after this many hours without a diff. Defaults to
# one sweep interval plus 48 hours, so raising OVERPASS_UPDATE_SLEEP does not
# leave the UI permanently complaining about a healthy sidecar.
# OVERPASS_LOCAL_STALE_AFTER_HOURS=216
#
# How many threads the PBF -> bzip2 XML conversion may use. Defaults to half
# the machine's cores, on the assumption the init container shares a box with
# other things. Raise it to convert faster; the step is CPU-bound and scales
# close to linearly.
# OVERPASS_CONVERT_THREADS=8
#
# How the downloaded extract is prepared for import. The mirrors publish
# .osm.pbf, but the Overpass importer runs `bunzip2 | update_database` and
# requires bzip2 XML, so the file is converted in place after download. The
# conversion normally happens in the init container instead, so what runs here
# is only a guard rejecting a truncated file. Override to do something else —
# a tag filter to shrink the import, say — and note that doing so drops the
# guard with it.
# OVERPASS_PLANET_PREPROCESS=sh /overpass_meta/preprocess.sh
