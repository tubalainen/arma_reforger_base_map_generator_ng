# OpenTopography API key (REQUIRED for global DEM fallback)
# Register for FREE at: https://portal.opentopography.org/
# After registering, go to "My Account" to get your API key
# Used for: Copernicus DEM 30m (COP30), SRTM 30m, ALOS World 3D 30m
# Replace demoapikey with your personal key to get higher details, register above
OPENTOPOGRAPHY_API_KEY=demoapikey

# Sweden - Lantmäteriet STAC API (elevation, vector, orthophotos)
# Register at https://apimanager.lantmateriet.se/
# Provides: 1-2m elevation (LiDAR), sub-meter orthophotos, official vector data
LANTMATERIET_USERNAME=
LANTMATERIET_PASSWORD=

# Denmark - Dataforsyningen
# Register at https://dataforsyningen.dk/
DATAFORSYNINGEN_TOKEN=

# Finland - NLS / Maanmittauslaitos
# Register at https://www.maanmittauslaitos.fi/en/rajapinnat/api-avaimen-ohje
NLS_FINLAND_API_KEY=

# Norway and Estonia require no API keys (open WCS endpoints)
# Latvia and Lithuania use Copernicus DEM 30m fallback via OpenTopography

# ==============================================================================
# Security Configuration (for reverse proxy setup)
# ==============================================================================

# CORS allowed origins (comma-separated)
# Add your domain when using nginx/Cloudflare reverse proxy
# Example: CORS_ORIGINS=https://maps.yourdomain.com,http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting
# General requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Map generation requests per hour per IP
RATE_LIMIT_GENERATE_PER_HOUR=10

# Trusted proxy IPs for forwarded headers (comma-separated)
# Used when behind nginx/Cloudflare
FORWARDED_ALLOW_IPS=127.0.0.1

# Log verbosity. Controls BOTH `docker compose logs` and the browser
# Activity Log — they are fed from the same records, so they can't drift apart.
# DEBUG adds per-tile / per-feature tracing: useful when diagnosing one
# specific map, very noisy otherwise.
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Container timezone — controls timestamps in server logs.
# Defaults to UTC if unset. Set to your local timezone so server logs
# match the browser UI timestamps.
# Examples: Europe/Stockholm, Europe/Berlin, America/New_York
TZ=UTC

# ---------------------------------------------------------------------------
# OpenStreetMap / Overpass
# ---------------------------------------------------------------------------
# The app queries a pool of public Overpass mirrors, probing them before each
# generation and using the fastest healthy one. Nothing here needs setting for
# normal use.

# Exclude the VK Maps mirror (maps.mail.ru) from the pool. It is a working,
# unmetered planet mirror, but it is Russian-operated — set this to 1 if that
# is not acceptable in your deployment.
# OVERPASS_DISABLE_VK=0

# Cache successful Overpass responses on disk, so regenerating the same square
# is instant and puts no load on the volunteer-run mirrors.
# OVERPASS_CACHE_ENABLED=1
# OVERPASS_CACHE_TTL_HOURS=24
# OVERPASS_CACHE_MAX_MB=512
